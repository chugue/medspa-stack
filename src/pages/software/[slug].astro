---
import Base from '../../layouts/Base.astro';
import { vendors, money, VERIFIED_LABEL, KLASS_LABEL, KLASS_NOTE, PAIRS, pairSlug, bySlug } from '../../data/site.js';

export function getStaticPaths() {
  return vendors.map(v => ({ params: { slug: v.slug }, props: { v } }));
}
const { v } = Astro.props;
const related = PAIRS.filter(p => p.includes(v.slug));
---
<Base
  title={`${v.name} pricing and features (2026) — verified from their own page`}
  description={`What ${v.name} costs, including setup fees and paid add-ons, plus whether it has genuine clinical charting. Verified ${VERIFIED_LABEL}.`}
>
<div class="crumb"><a href="/">Home</a> → <a href="/software/">Software</a> → {v.name}</div>
<h1>{v.name}</h1>

<p class="lede">
  <span class={`tag ${v.klass}`}>{KLASS_LABEL[v.klass]}</span>
  {v.segment ? ` · ${v.segment}` : ''}
</p>

<div class="note">
  <p>
    {v.pricingPublic
      ? <>Publishes pricing. Starting price {v.startingPrice != null ? <strong>{money(v.startingPrice)}/mo</strong> : 'listed by tier'}{v.setupFee ? <> plus a <strong>{money(v.setupFee)}</strong> one-time setup fee</> : ''}.</>
      : <>Does not publish pricing — a sales call is required to get a quote.</>}
    {v.freeTrial ? <> Free trial: {v.freeTrial}.</> : ''}
  </p>
  <p class="stamp" style="margin-top:.5rem">
    Verified {VERIFIED_LABEL} from
    {v.pricingUrl ? <> <a href={v.pricingUrl} rel="nofollow noopener" target="_blank">the vendor's pricing page</a></> : <> the vendor's site</>}.
  </p>
</div>

{v.tiers?.length > 0 && (
  <>
    <h2>Published tiers</h2>
    <div class="scroll">
    <table>
      <thead><tr><th>Tier</th><th class="num">Price</th><th>Billing basis</th><th>Includes</th></tr></thead>
      <tbody>
        {v.tiers.map(t => (
          <tr>
            <td><strong>{t.tier_name || '—'}</strong></td>
            <td class="num">{t.monthly_price_usd != null ? money(t.monthly_price_usd) + '/mo' : 'Quote'}</td>
            <td>{t.billing_note || '—'}</td>
            <td>{t.what_it_includes || '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  </>
)}

{v.hiddenCosts && (
  <>
    <h2>What sits outside the headline price</h2>
    <p>{v.hiddenCosts}</p>
  </>
)}

{v.processing && (
  <>
    <h3>Payment processing</h3>
    <p>{v.processing}</p>
  </>
)}

<h2>Clinical capability</h2>
<p>{v.clinical || 'Not verified.'}</p>
<p class="stamp">{KLASS_NOTE[v.klass]}</p>

{v.hipaa && (
  <>
    <h2>HIPAA</h2>
    <p>{v.hipaa}</p>
    <p class="stamp">
      We record what the vendor states publicly. A published compliance claim is not the same as a
      signed business associate agreement — ask for the BAA in writing before you migrate patient
      data.
    </p>
  </>
)}

{related.length > 0 && (
  <>
    <h2>Compared with</h2>
    <div class="cards">
      {related.map(p => {
        const other = bySlug[p.find(s => s !== v.slug)];
        return other ? (
          <a class="card" href={`/compare/${pairSlug(p)}/`}>
            <div class="n">{bySlug[p[0]]?.name} vs {bySlug[p[1]]?.name}</div>
            <div class="p">Side-by-side pricing and clinical capability</div>
          </a>
        ) : null;
      })}
    </div>
  </>
)}

<hr />
<div class="note">
  <p>
    <strong>Correction policy.</strong> {v.name} can change its pricing at any time without telling
    us. If what you were quoted differs from what is above, that is a defect on our side and we
    want the detail — <a href="/about/">send it over</a> and we will recheck and republish with a
    new date. We do not remove unflattering facts at a vendor's request; we do correct wrong ones
    immediately.
  </p>
</div>

<p class="stamp">
  <a href={v.url} rel="nofollow noopener" target="_blank">{v.name}'s official site</a> ·
  <a href="/disclosure/">Do we earn a commission from {v.name}?</a>
</p>
</Base>
