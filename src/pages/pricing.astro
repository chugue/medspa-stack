---
import Base from '../layouts/Base.astro';
import Stamp from '../components/Stamp.astro';
import { vendors, money, KLASS_LABEL, badge } from '../data/site.js';

const pub = vendors.filter(v => v.pricingPublic);
const priv = vendors.filter(v => !v.pricingPublic);
const withNotes = vendors.filter(v => v.hiddenCosts);
---
<Base
  title="Med spa software pricing database (2026) — every published tier and fee"
  description={`Verified starting prices, tier structures, onboarding fees and add-on costs for ${vendors.length} med spa and aesthetics platforms. Read from vendor pricing pages and dated.`}
  crumbs={['Pricing database']}
>
<section class="ms-section">
  <p class="ms-eyebrow">Data</p>
  <h1 class="ms-display">Med spa software pricing database</h1>
  <p class="ms-lede ms-measure">
    Every published price we can verify, plus the fees that do not appear next to it. Collected by
    reading each vendor's own pricing page — never a third-party directory, because those go stale
    and nobody dates them.
  </p>
  <Stamp />
</section>

<section class="ms-section">
  <div class="ms-callout">
    <p class="ms-callout-title">{pub.length} of {vendors.length} platforms publish a price</p>
    <p>
      The other {priv.length} require a sales call. We list those too, with whatever tier structure
      they disclose, because "you must call to find out" is itself useful information when you are
      shortlisting and budgeting your own time.
    </p>
  </div>
</section>

<section class="ms-section">
  <p class="ms-kicker">Published pricing</p>
  <h2 class="ms-h2">{pub.length} platforms with public rates</h2>
  <div class="ms-scroller">
    <table class="ms-data ms-data-sticky">
      <thead>
        <tr>
          <th scope="col">Platform</th>
          <th scope="col">Type</th>
          <th scope="col" class="num">From</th>
          <th scope="col" class="num">Setup</th>
          <th scope="col">Billing basis</th>
          <th scope="col">Free trial</th>
        </tr>
      </thead>
      <tbody>
      {pub.map(v => (
        <tr>
          <td>
            <span class="ms-cell-name"><a href={`/software/${v.slug}/`}>{v.displayName}</a></span>
            {v.promo && <span class="ms-cell-flags"><span class="ms-badge ms-badge-promo">Promo rate</span></span>}
          </td>
          <td><span class={badge(v.klass)}>{KLASS_LABEL[v.klass]}</span></td>
          <td class="num num-strong">{v.startingPrice != null ? money(v.startingPrice) + '/mo' : '—'}</td>
          <td class="num">{v.setupFee ? money(v.setupFee) : <span class="nil">—</span>}</td>
          <td class="prose">{(v.entryNote || '—').split(';')[0]}</td>
          <td class="prose">{v.freeTrial ? String(v.freeTrial).split(';')[0] : <span class="nil">Not stated</span>}</td>
        </tr>
      ))}
      </tbody>
    </table>
  </div>
</section>

<section class="ms-section">
  <p class="ms-kicker">Quote only</p>
  <h2 class="ms-h2">{priv.length} platforms that will not publish a rate</h2>
  <p class="ms-measure">
    Several of these are the most clinically capable systems in the category — that is the
    trade-off. Expect a discovery call and a proposal keyed to your provider count.
  </p>
  <div class="ms-scroller">
    <table class="ms-data">
      <thead>
        <tr>
          <th scope="col">Platform</th>
          <th scope="col">Type</th>
          <th scope="col">What they do disclose</th>
        </tr>
      </thead>
      <tbody>
      {priv.map(v => (
        <tr>
          <td><span class="ms-cell-name"><a href={`/software/${v.slug}/`}>{v.displayName}</a></span></td>
          <td><span class={badge(v.klass)}>{KLASS_LABEL[v.klass]}</span></td>
          <td class="prose">{v.tiers?.length
            ? `${v.tiers.length} named tier${v.tiers.length > 1 ? 's' : ''}: ${v.tiers.map(t => t.tier_name).filter(Boolean).join(', ')}`
            : <span class="nil">No public tier structure</span>}</td>
        </tr>
      ))}
      </tbody>
    </table>
  </div>
</section>

<section class="ms-section">
  <p class="ms-kicker">The part comparison tables flatten away</p>
  <h2 class="ms-h2">Fees that sit outside the sticker price</h2>
  <p class="ms-measure">
    Each note below is taken from the vendor's own published material on the verification date
    above. Where a figure is a range, it is because the vendor publishes it as one.
  </p>

  <div class="ms-stack">
  {withNotes.map(v => (
    <div class="ms-callout">
      <p class="ms-callout-title"><a href={`/software/${v.slug}/`}>{v.displayName}</a></p>
      <p>{v.hiddenCosts}</p>
    </div>
  ))}
  </div>
</section>

<section class="ms-section">
  <div class="ms-callout ms-callout-caution">
    <p class="ms-callout-title">Corrections</p>
    <p>
      If a price here is wrong or out of date, it is a defect and we want to know. Prices move in
      this category without announcement, and a stale figure is worse than no figure.
      <a href="/about/">Send us the vendor page</a> and we will republish with a new verification
      date — whether the correction flatters the vendor or not.
    </p>
  </div>
</section>
</Base>
