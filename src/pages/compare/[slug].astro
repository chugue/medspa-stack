---
import Base from '../../layouts/Base.astro';
import Stamp from '../../components/Stamp.astro';
import { vendors, bySlug, money, KLASS_LABEL, KLASS_PHRASE, PAIRS, pairSlug, badge, VERIFIED_LABEL } from '../../data/site.js';

export function getStaticPaths() {
  return PAIRS
    .filter(p => bySlug[p[0]] && bySlug[p[1]])
    .map(p => ({ params: { slug: pairSlug(p) }, props: { a: bySlug[p[0]], b: bySlug[p[1]] } }));
}
const { a, b } = Astro.props;

// win: which side is the more transparent / lower-cost answer on that row, where that is meaningful
const rows = [
  ['Published price',
    v => v.startingPrice != null ? `${money(v.startingPrice)}/mo` : 'None. Sales quote only.',
    v => v.pricingPublic && (!a.pricingPublic || !b.pricingPublic)],
  ['Entry tier', v => v.entryTier || '—', () => false],
  ['Billing basis', v => (v.entryNote || '—').split(';')[0], () => false],
  ['One-time setup fee', v => v.setupFee ? money(v.setupFee) : 'None published',
    v => !v.setupFee && (a.setupFee || b.setupFee)],
  ['Free trial', v => v.freeTrial || 'Not published', () => false],
  ['Named tiers', v => v.tiers?.length ? v.tiers.map(t => t.tier_name).filter(Boolean).join(', ') : '—', () => false],
  ['Target segment', v => v.segment || '—', () => false],
  ['Payment processing', v => v.processing || 'Not published', () => false],
];

const differentClass = a.klass !== b.klass;
const onePriced = a.pricingPublic !== b.pricingPublic;
---
<Base
  title={`${a.displayName} vs ${b.displayName} (2026) — pricing and clinical capability compared`}
  description={`A side-by-side of ${a.displayName} and ${b.displayName}: published pricing, setup fees, billing basis and whether each has genuine medical charting. Verified ${VERIFIED_LABEL}.`}
  crumbs={[['Platforms', '/software/'], `${a.displayName} vs ${b.displayName}`]}
>
<section class="ms-section">
  <p class="ms-eyebrow">Comparison</p>
  <h1 class="ms-display">{a.displayName} vs {b.displayName}</h1>
  <p class="ms-lede ms-measure">
    Verified pricing and capability, read from each vendor's own published material. We do not
    score these out of ten — the right answer depends on whether you chart treatments and how your
    team is shaped.
  </p>
  <Stamp />
</section>

{differentClass && (
  <section class="ms-section">
    <div class="ms-callout ms-callout-accent">
      <p class="ms-callout-title">These are not the same kind of product</p>
      <p>
        {a.displayName} is {KLASS_PHRASE[a.klass]}. {b.displayName} is {KLASS_PHRASE[b.klass]}.
        Before comparing price, work out which category your practice needs —
        <a href="/emr-vs-booking/">we sorted all {vendors.length} platforms on that axis</a>.
        Choosing on price across this line is how practices end up paying for two systems.
      </p>
    </div>
  </section>
)}

<section class="ms-section">
  <div class="ms-scroller">
    <table class="ms-compare">
      <thead>
        <tr>
          <th scope="col"><span class="ms-kicker" style="margin:0">Criterion</span></th>
          <th scope="col">
            <span class="ms-compare-vendor">{a.displayName}</span>
            <span class={badge(a.klass)} style="margin-top:8px">{KLASS_LABEL[a.klass]}</span>
          </th>
          <th scope="col">
            <span class="ms-compare-vendor">{b.displayName}</span>
            <span class={badge(b.klass)} style="margin-top:8px">{KLASS_LABEL[b.klass]}</span>
          </th>
        </tr>
      </thead>
      <tbody>
        {rows.map(([label, fn, win]) => (
          <tr>
            <th scope="row">{label}</th>
            <td class={win(a) ? 'ms-win' : (fn(a) || '').startsWith('None') || (fn(a) || '').startsWith('Not') ? 'nil' : ''}>{fn(a)}</td>
            <td class={win(b) ? 'ms-win' : (fn(b) || '').startsWith('None') || (fn(b) || '').startsWith('Not') ? 'nil' : ''}>{fn(b)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

{onePriced && (
  <section class="ms-section">
    <div class="ms-callout">
      <p class="ms-callout-title">One of these will not tell you the price</p>
      <p>
        That makes a direct cost comparison impossible without a sales call, and the asymmetry is
        worth weighing on its own. A vendor that publishes rates is one you can budget against
        before committing your time to a demo cycle.
      </p>
    </div>
  </section>
)}

<section class="ms-section">
  <p class="ms-kicker">Clinical capability</p>
  <h2 class="ms-h2">What each one does in the treatment room</h2>
  <h3 class="ms-h3">{a.displayName}</h3>
  <p class="ms-measure">{a.clinical || 'Not verified.'}</p>
  <h3 class="ms-h3">{b.displayName}</h3>
  <p class="ms-measure">{b.clinical || 'Not verified.'}</p>
</section>

<section class="ms-section">
  <p class="ms-kicker">Beyond the sticker</p>
  <h2 class="ms-h2">Costs outside the headline price</h2>
  <div class="ms-stack">
    {[a, b].map(v => v.hiddenCosts && (
      <div class="ms-callout ms-callout-caution">
        <p class="ms-callout-title">{v.displayName}</p>
        <p>{v.hiddenCosts}</p>
      </div>
    ))}
  </div>
</section>

<section class="ms-section">
  <h2 class="ms-h2">How to decide</h2>
  <h3 class="ms-h3">Settle the category question first</h3>
  <p class="ms-measure">
    If you document procedures, a booking-only platform is not a candidate at any price.
  </p>
  <h3 class="ms-h3">Convert both to your shape</h3>
  <p class="ms-measure">
    Compare locations and providers rather than sticker prices. Per-location and per-user models
    diverge sharply once you are past a solo practice.
    <a href="/cost-calculator/">The calculator does this.</a>
  </p>
  <h3 class="ms-h3">Add the modules you will actually turn on</h3>
  <p class="ms-measure">
    In this category, forms, e-prescribing, marketing and text messaging are frequently separate
    line items rather than plan features.
  </p>
  <h3 class="ms-h3">Make them demonstrate charting with your treatments</h3>
  <p class="ms-measure">
    And get the BAA in writing before migrating any patient data.
  </p>
</section>

<section class="ms-section">
  <div class="ms-grid">
    <a class="ms-linkcard" href={`/software/${a.slug}/`}>
      <span class="ms-linkcard-title">{a.displayName} in full</span>
      <p class="ms-linkcard-desc">All tiers, fees and verification sources.</p>
      <span class="ms-linkcard-meta">Platform</span>
    </a>
    <a class="ms-linkcard" href={`/software/${b.slug}/`}>
      <span class="ms-linkcard-title">{b.displayName} in full</span>
      <p class="ms-linkcard-desc">All tiers, fees and verification sources.</p>
      <span class="ms-linkcard-meta">Platform</span>
    </a>
  </div>
</section>
</Base>
