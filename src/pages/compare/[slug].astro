---
import Base from '../../layouts/Base.astro';
import { vendors, bySlug, money, VERIFIED_LABEL, KLASS_LABEL, PAIRS, pairSlug } from '../../data/site.js';

export function getStaticPaths() {
  return PAIRS
    .filter(p => bySlug[p[0]] && bySlug[p[1]])
    .map(p => ({ params: { slug: pairSlug(p) }, props: { a: bySlug[p[0]], b: bySlug[p[1]] } }));
}
const { a, b } = Astro.props;

const rows = [
  ['Type', v => KLASS_LABEL[v.klass]],
  ['Publishes pricing', v => v.pricingPublic ? 'Yes' : 'No — quote only'],
  ['Starting price', v => v.startingPrice != null ? money(v.startingPrice) + '/mo' : 'Not published'],
  ['Entry tier', v => v.entryTier || '—'],
  ['Billing basis', v => (v.entryNote || '—').split(';')[0]],
  ['One-time setup fee', v => v.setupFee ? money(v.setupFee) : 'None published'],
  ['Free trial', v => v.freeTrial || 'Not published'],
  ['Named tiers', v => v.tiers?.length ? v.tiers.map(t => t.tier_name).filter(Boolean).join(', ') : '—'],
  ['Target segment', v => v.segment || '—'],
  ['Payment processing', v => v.processing || 'Not published'],
];

const differentClass = a.klass !== b.klass;
const onePriced = a.pricingPublic !== b.pricingPublic;
---
<Base
  title={`${a.name} vs ${b.name} (2026) — pricing and clinical capability compared`}
  description={`A side-by-side of ${a.name} and ${b.name}: published pricing, setup fees, billing basis and whether each has genuine medical charting. Verified ${VERIFIED_LABEL}.`}
>
<div class="crumb"><a href="/">Home</a> → <a href="/software/">Software</a> → {a.name} vs {b.name}</div>
<h1>{a.name} vs {b.name}</h1>

<p class="lede">
  Verified pricing and capability, read from each vendor's own published material on
  {' '}{VERIFIED_LABEL}. We do not score these out of ten — the right answer depends on whether you
  chart treatments and how your team is shaped.
</p>

{differentClass && (
  <div class="note accent">
    <p>
      <strong>These are not the same kind of product.</strong> {a.name} is a
      {' '}{KLASS_LABEL[a.klass].toLowerCase()}; {b.name} is a {KLASS_LABEL[b.klass].toLowerCase()}.
      Before comparing price, work out which category your practice needs —
      <a href="/emr-vs-booking/">we sorted all {vendors.length} platforms on that axis</a>.
      Choosing on price across this line is how practices end up paying for two systems.
    </p>
  </div>
)}

<div class="scroll">
<table>
  <thead><tr><th></th><th>{a.name}</th><th>{b.name}</th></tr></thead>
  <tbody>
    {rows.map(([label, fn]) => (
      <tr><th style="background:#fff">{label}</th><td>{fn(a)}</td><td>{fn(b)}</td></tr>
    ))}
  </tbody>
</table>
</div>

{onePriced && (
  <div class="note">
    <p>
      One of these publishes pricing and the other does not, which makes a direct cost comparison
      impossible without a sales call. That asymmetry is worth weighing on its own: a vendor that
      publishes rates is one you can budget against before committing your time to a demo cycle.
    </p>
  </div>
)}

<h2>Clinical capability, side by side</h2>
<h3>{a.name}</h3>
<p>{a.clinical || 'Not verified.'}</p>
<h3>{b.name}</h3>
<p>{b.clinical || 'Not verified.'}</p>

<h2>Costs outside the headline price</h2>
{[a, b].map(v => v.hiddenCosts && (
  <>
    <h3>{v.name}</h3>
    <p>{v.hiddenCosts}</p>
  </>
))}

<h2>How to decide</h2>
<ol>
  <li>
    Settle the category question first. If you document procedures, a booking-only platform is not
    a candidate at any price.
  </li>
  <li>
    Convert both to <em>your</em> shape — locations and providers — rather than comparing sticker
    prices. Per-location and per-user models diverge sharply once you are past a solo practice.
    <a href="/cost-calculator/">The calculator does this.</a>
  </li>
  <li>
    Add the modules you will actually turn on. In this category, forms, e-prescribing, marketing
    and text messaging are frequently separate line items.
  </li>
  <li>
    Ask each vendor to demonstrate charting with your own treatment types, and get the BAA in
    writing before migrating patient data.
  </li>
</ol>

<div class="cards">
  <a class="card" href={`/software/${a.slug}/`}><div class="n">{a.name} in full</div><div class="p">All tiers, fees and verification sources</div></a>
  <a class="card" href={`/software/${b.slug}/`}><div class="n">{b.name} in full</div><div class="p">All tiers, fees and verification sources</div></a>
</div>

<hr />
<p class="stamp">
  Verified {VERIFIED_LABEL}. We earn affiliate commission from some vendors and not others; that
  has no bearing on the ordering or content of this page.
  <a href="/disclosure/">See exactly who pays us</a>.
</p>
</Base>
