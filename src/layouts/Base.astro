---
import '../styles/tokens.css';
import '../styles/components.css';

const { title, description, noindex, crumbs } = Astro.props;
const nav = [
  ['/pricing/', 'Pricing database'],
  ['/software/', 'Platforms'],
  ['/emr-vs-booking/', 'EMR or booking'],
  ['/cost-calculator/', 'Cost calculator'],
  ['/disclosure/', 'Disclosure'],
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
<meta name="theme-color" content="#f2f2f3" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1d1f20" media="(prefers-color-scheme: dark)" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="MedSpaStack" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="canonical" href={new URL(path, Astro.site)} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="preload" href="/fonts/barlow-400.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/barlow-condensed-600.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
<header class="ms-header">
  <div class="ms-header-in">
    <a class="ms-wordmark" href="/">MedSpa<em>Stack</em></a>
    <nav class="ms-nav">
      {nav.map(([h, l]) => <a href={h} aria-current={path === h ? 'page' : undefined}>{l}</a>)}
    </nav>
  </div>
</header>

<div class="ms-page">
  {crumbs && (
    <nav class="ms-crumb">
      <a href="/">Home</a>
      {crumbs.map(c => Array.isArray(c)
        ? <><span aria-hidden="true">/</span><a href={c[1]}>{c[0]}</a></>
        : <><span aria-hidden="true">/</span><span>{c}</span></>)}
    </nav>
  )}
  <main><slot /></main>
</div>

<footer class="ms-footer">
  <div class="ms-page">
    <div class="ms-footer-cols">
      <div>
        <p class="ms-kicker">MedSpaStack</p>
        <p class="ms-measure">
          Independent pricing and capability research on med spa and aesthetics practice
          software. Every figure is read off the vendor's own published page and carries the
          date it was verified.
        </p>
      </div>
      <div>
        <p class="ms-kicker">Research</p>
        <p><a href="/pricing/">Pricing database</a></p>
        <p><a href="/software/">All platforms</a></p>
        <p><a href="/emr-vs-booking/">EMR or booking</a></p>
        <p><a href="/cost-calculator/">Cost calculator</a></p>
      </div>
      <div>
        <p class="ms-kicker">About</p>
        <p><a href="/about/">Who runs this</a></p>
        <p><a href="/methodology/">How we verify</a></p>
        <p><a href="/disclosure/">Affiliate disclosure</a></p>
      </div>
    </div>
    <p class="ms-disclosure">
      We earn affiliate commission from some of the platforms listed here. Every page carrying a
      paid link says so, and the <a href="/disclosure/">disclosure page</a> names exactly which
      vendors pay us and which do not. Commission never affects placement, ordering or
      classification. © 2026 MedSpaStack.
    </p>
  </div>
</footer>
</body>
</html>
