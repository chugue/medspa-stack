---
import { VERIFIED_LABEL } from '../data/site.js';
const { small } = Astro.props;
---
<div class="ms-stack" style="gap:var(--space-3);align-items:flex-start">
  <span class={small ? 'ms-stamp ms-stamp-sm' : 'ms-stamp'}>
    <span class="ms-stamp-mark">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3l7.5 3.5v5c0 4.5-3.1 8.2-7.5 9.5-4.4-1.3-7.5-5-7.5-9.5v-5z"></path>
        <path d="M9 12l2 2 4-4"></path>
      </svg>
    </span>
    <span class="ms-stamp-rule"></span>
    <span class="ms-stamp-body">
      <span class="ms-stamp-label">Pricing last verified</span>
      <span class="ms-stamp-date">{VERIFIED_LABEL}</span>
    </span>
  </span>
  <span class="ms-stamp-note" style="max-width:46ch">
    <slot>Rechecked weekly against each vendor's own pricing page. <a href="/methodology/">Method and disclosures</a>.</slot>
  </span>
</div>
